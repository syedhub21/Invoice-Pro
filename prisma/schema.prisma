generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BusinessProfile {
  id              String   @id @default(cuid())
  companyName     String   @default("My Business")
  address         String   @default("")
  mobile          String   @default("")
  email           String   @default("")
  gstin           String   @default("")
  pan             String   @default("")
  bankName        String   @default("")
  bankAccount     String   @default("")
  bankIfsc        String   @default("")
  upiId           String   @default("")
  logoPath        String   @default("")
  signaturePath   String   @default("")
  termsConditions String   @default("1. Goods once sold will not be taken back.\n2. Interest will be charged on overdue payments.\n3. Subject to local jurisdiction.\n4. Errors & Omissions Expected.")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    Int           @unique
  date             DateTime      @default(now())
  dueDate          DateTime?
  clientName       String        @default("")
  clientMobile     String        @default("")
  clientAddress    String        @default("")
  clientGstin      String        @default("")
  subtotal         Float         @default(0)
  taxEnabled       Boolean       @default(false)
  taxRate          Float         @default(0)
  taxAmount        Float         @default(0)
  discountEnabled  Boolean       @default(false)
  discountType     String        @default("flat")
  discountValue    Float         @default(0)
  discountAmount   Float         @default(0)
  totalAmount      Float         @default(0)
  amountInWords    String        @default("")
  preparedBy       String        @default("")
  checkedBy        String        @default("")
  receivedBy       String        @default("")
  notes            String        @default("")
  status           String        @default("draft")
  template         String        @default("classic")
  includeQr        Boolean       @default(false)
  includeSignature Boolean       @default(false)
  items            InvoiceItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  sno         Int      @default(0)
  description String   @default("")
  pack        String   @default("")
  qty         Float    @default(0)
  mrp         Float    @default(0)
  rate        Float    @default(0)
  amount      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceDraft {
  id        String   @id @default(cuid())
  data      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model RecurringInvoice {
  id            String    @id @default(cuid())
  name          String    @default("")
  frequency     String    @default("monthly")
  dayOfWeek     Int       @default(1)
  dayOfMonth    Int       @default(1)
  monthOfYear   Int       @default(1)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  nextDueDate   DateTime  @default(now())
  lastGenerated DateTime?
  active        Boolean   @default(true)
  templateData  String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
